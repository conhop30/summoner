// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.summoner.championcreator",
  "asar": true,
  "productName": "Summoner",
  // Where the installed app looks for updates (electron-updater reads latest.yml from
  // the newest release), and where `npm run release` uploads to.
  "publish": [
    { "provider": "github", "owner": "conhop30", "repo": "summoner", "releaseType": "release" }
  ],
  "directories": {
    "output": "release/${version}"
  },
  // Ships the built app and the two runtime dependencies. The renderer's libraries (React and the
  // rest) are already bundled into dist, so they live in devDependencies and stay out of the package.
  "files": [
    "dist",
    "dist-electron",
    // better-sqlite3 arrives with its SQLite source and build inputs; only the compiled .node and
    // its JS are used at run time.
    "!node_modules/better-sqlite3/{deps,src}/**"
  ],
  // The app is English only, so skip the ~50 Chromium locale packs.
  "electronLanguages": ["en-US"],
  "compression": "maximum",
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}